# API keys for testing LLM Derby against real providers.
# Copy to .env and fill in the ones you need: cp .env.example .env
# .env is git-ignored. Never commit real keys, and never prefix these with VITE_
# (Vite would bake VITE_* variables into the public build).

NEBIUS_API_KEY=
OPENAI_API_KEY=
GMI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=
BASETEN_API_KEY=

# Optional custom OpenAI-compatible endpoint
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
